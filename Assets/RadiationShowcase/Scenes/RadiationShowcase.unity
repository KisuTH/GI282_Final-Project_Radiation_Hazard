  endLayer: 5
  fadeDuration: 3
  deathRestartDelay: 12
  lethalDose: 4
  suitFactor: 0.4
  pillFactor: 0.5
  steps:
  - id: geiger
    title: "\u0E2B\u0E22\u0E34\u0E1A Geiger Counter \u0E08\u0E32\u0E01\u0E15\u0E39\u0E49\u0E09\u0E38\u0E01\u0E40\u0E09\u0E34\u0E19"
    howTo: "\u0E2B\u0E22\u0E34\u0E1A\u0E02\u0E27\u0E32\u0E19\u0E02\u0E49\u0E32\u0E07\u0E15\u0E39\u0E49
      (Grip) \u0E40\u0E2B\u0E27\u0E35\u0E48\u0E22\u0E07\u0E17\u0E38\u0E1A\u0E01\u0E23\u0E30\u0E08\u0E01\u0E43\u0E2B\u0E49\u0E41\u0E15\u0E01
      \u0E41\u0E25\u0E49\u0E27\u0E08\u0E31\u0E1A\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E16\u0E37\u0E2D\u0E44\u0E27\u0E49
      \u0E04\u0E48\u0E32\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E14\u0E39\u0E44\u0E14\u0E49\u0E08\u0E32\u0E01\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19"
  - id: suit
    title: "\u0E2A\u0E27\u0E21\u0E0A\u0E38\u0E14\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E23\u0E31\u0E07\u0E2A\u0E35"
    howTo: "\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E23\u0E32\u0E27\u0E41\u0E02\u0E27\u0E19\u0E0A\u0E38\u0E14
      \u0E01\u0E14 Grip \u0E08\u0E31\u0E1A\u0E0A\u0E38\u0E14\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49
      \u0E41\u0E25\u0E49\u0E27\u0E14\u0E36\u0E07\u0E21\u0E32\u0E41\u0E19\u0E1A\u0E15\u0E31\u0E27"
  - id: fan
    title: "\u0E1B\u0E34\u0E14\u0E1E\u0E31\u0E14\u0E25\u0E21\u0E23\u0E30\u0E1A\u0E32\u0E22\u0E2D\u0E32\u0E01\u0E32\u0E28"
    howTo: "\u0E08\u0E31\u0E1A\u0E2B\u0E31\u0E27\u0E04\u0E31\u0E19\u0E42\u0E22\u0E01\u0E2A\u0E35\u0E41\u0E14\u0E07\u0E1A\u0E19\u0E41\u0E1C\u0E07\u0E2A\u0E35\u0E1F\u0E49\u0E32
      (Grip) \u0E41\u0E25\u0E49\u0E27\u0E42\u0E22\u0E01\u0E25\u0E07\u0E08\u0E19\u0E2A\u0E38\u0E14"
  - id: pill
    title: "\u0E01\u0E34\u0E19\u0E22\u0E32 Potassium Iodide (KI)"
    howTo: "\u0E2B\u0E22\u0E34\u0E1A\u0E02\u0E27\u0E14\u0E22\u0E32\u0E2A\u0E35\u0E2A\u0E49\u0E21\u0E1A\u0E19\u0E42\u0E15\u0E4A\u0E30
      \u0E41\u0E25\u0E49\u0E27\u0E22\u0E01\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32\u0E17\u0E35\u0E48\u0E1B\u0E32\u0E01"
  - id: 
    title: "\u0E40\u0E14\u0E34\u0E19\u0E1D\u0E48\u0E32\u0E42\u0E0B\u0E19\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E17\u0E32\u0E07\u0E2D\u0E2D\u0E01"
    howTo: "\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E23\u0E31\u0E48\u0E27\u0E2D\u0E22\u0E39\u0E48\u0E02\u0E49\u0E32\u0E07\u0E1B\u0E23\u0E30\u0E15\u0E39!
      \u0E14\u0E39\u0E04\u0E48\u0E32\u0E08\u0E32\u0E01 Geiger \u0E41\u0E25\u0E49\u0E27\u0E23\u0E35\u0E1A\u0E1C\u0E48\u0E32\u0E19\u0E27\u0E07\u0E41\u0E14\u0E07
      (\u0E01\u0E14\u0E2A\u0E15\u0E34\u0E4A\u0E01\u0E0B\u0E49\u0E32\u0E22 = \u0E27\u0E34\u0E48\u0E07)
      \u0E44\u0E1B\u0E17\u0E35\u0E48 EXIT"
